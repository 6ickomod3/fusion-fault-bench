        "reported_covariance_structure": {
          "const": "diagonal",
          "title": "Reported Covariance Structure",
          "type": "string"
        },
        "reported_std_xy_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Reported Std Xy M",
          "type": "array"
        },
        "temporal_dependence": {
          "const": "iid",
          "title": "Temporal Dependence",
          "type": "string"
        },
        "true_covariance_structure": {
          "const": "diagonal",
          "title": "True Covariance Structure",
          "type": "string"
        },
        "true_error_distribution": {
          "const": "gaussian",
          "title": "True Error Distribution",
          "type": "string"
        },
        "true_error_mean_xy_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": 0.0
