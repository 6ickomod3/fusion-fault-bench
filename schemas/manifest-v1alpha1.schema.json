            {
              "const": 0.0
            }
          ],
          "title": "True Error Mean Xy M",
          "type": "array"
        }
      },
      "required": [
        "output_space",
        "true_error_distribution",
        "true_error_mean_xy_m",
        "true_covariance_structure",
        "actual_std_xy_m",
        "reported_covariance_structure",
        "reported_std_xy_m",
        "temporal_dependence",
        "range_dependence"
      ],
      "title": "CartesianGaussianSensorSpec",
      "type": "object"
