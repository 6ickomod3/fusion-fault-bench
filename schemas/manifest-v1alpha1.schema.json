        }
      ],
      "type": "array"
    },
    "BootstrapSpec": {
      "additionalProperties": false,
      "description": "Complete-sequence paired percentile bootstrap.",
      "properties": {
        "confidence_level": {
          "maximum": 0.95,
          "minimum": 0.95,
          "title": "Confidence Level",
          "type": "number"
        },
        "interval_scope": {
          "const": "pointwise",
          "title": "Interval Scope",
          "type": "string"
        },
        "method": {
          "const": "percentile",
          "title": "Method",
          "type": "string"
        },
        "replicates": {
          "minimum": 200,
          "multipleOf": 40,
          "title": "Replicates",
          "type": "integer"
        },
        "resampling": {
          "const": "paired-indices-across-severities-and-methods",
          "title": "Resampling",
          "type": "string"
        },
        "unit": {
          "const": "sequence",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "method",
        "unit",
        "resampling",
        "interval_scope",
        "replicates",
        "confidence_level"
      ],
      "title": "BootstrapSpec",
      "type": "object"
    },
