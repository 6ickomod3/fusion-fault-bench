{
  "$defs": {
    "AdditivePositionBiasFault": {
      "additionalProperties": false,
      "description": "z_target <- z_target + direction * magnitude * axis_vector.",
      "properties": {
        "axis": {
          "enum": [
            "x",
            "y"
          ],
          "title": "Axis",
          "type": "string"
        },
        "direction_policy": {
          "const": "symmetric-paired",
          "title": "Direction Policy",
          "type": "string"
        },
        "injection_site": {
          "const": "estimator-output",
          "title": "Injection Site",
          "type": "string"
        },
        "kind": {
          "const": "additive-position-bias",
          "title": "Kind",
          "type": "string"
        },
        "magnitude_values_m": {
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "title": "Magnitude Values M",
          "type": "array"
        },
        "persistence": {
          "const": "sequence",
          "title": "Persistence",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Modality"
        },
        "unit": {
          "const": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "axis",
        "unit",
        "injection_site",
        "direction_policy",
        "persistence",
        "magnitude_values_m"
      ],
      "title": "AdditivePositionBiasFault",
      "type": "object"
    },
    "AnalyticCrossoverManifest": {
      "additionalProperties": false,
      "description": "Closed-form-compatible single-sensor crossover experiment.",
      "properties": {
        "analytic_validation": {
          "$ref": "#/$defs/AnalyticValidationSpec"
        },
        "evaluation": {
          "$ref": "#/$defs/SingleSensorCrossoverEvaluation"
        },
        "experiment": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
          "title": "Experiment",
          "type": "string"
        },
        "fault_sweep": {
          "$ref": "#/$defs/AnalyticSingleSensorFault"
        },
        "kind": {
          "const": "analytic-crossover",
          "title": "Kind",
          "type": "string"
        },
        "methods": {
          "$ref": "#/$defs/PrimaryMethods"
        },
        "observations": {
          "$ref": "#/$defs/ObservationModelsSpec"
        },
        "rng": {
          "$ref": "#/$defs/RngSpec"
        },
        "schema": {
          "const": "ffb.manifest/v1alpha1",
          "title": "Schema",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/AnalyticSource"
        }
      },
      "required": [
        "schema",
        "kind",
        "experiment",
        "rng",
        "source",
        "analytic_validation",
        "observations",
        "fault_sweep",
        "methods",
        "evaluation"
      ],
      "title": "AnalyticCrossoverManifest",
      "type": "object"
    },
    "AnalyticSingleSensorFault": {
      "discriminator": {
        "mapping": {
          "additive-position-bias": "#/$defs/AdditivePositionBiasFault",
          "increased-noise-correctly-reported": "#/$defs/CorrectlyReportedNoiseFault",
          "increased-noise-underreported": "#/$defs/UnderreportedNoiseFault"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AdditivePositionBiasFault"
        },
        {
          "$ref": "#/$defs/CorrectlyReportedNoiseFault"
        },
        {
          "$ref": "#/$defs/UnderreportedNoiseFault"
        }
      ]
    },
    "AnalyticSource": {
      "additionalProperties": false,
      "description": "Closed-form one-object, one-frame Gaussian verification case.",
      "properties": {
        "case_id": {
          "const": "one-object-static-local-error-gaussian-v1",
          "title": "Case Id",
          "type": "string"
        },
        "kind": {
          "const": "analytic",
          "title": "Kind",
          "type": "string"
        },
        "sequence_count": {
          "minimum": 2,
          "title": "Sequence Count",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "case_id",
        "sequence_count"
      ],
      "title": "AnalyticSource",
      "type": "object"
    },
    "AnalyticValidationSpec": {
      "additionalProperties": false,
      "description": "Fixed independent-oracle acceptance thresholds for analytic runs.",
      "properties": {
        "continuous_root_reporting": {
          "const": "separate-from-grid-estimand",
          "title": "Continuous Root Reporting",
          "type": "string"
        },
        "grid_crossover_abs_tolerance": {
          "maximum": 1e-12,
          "minimum": 1e-12,
          "title": "Grid Crossover Abs Tolerance",
          "type": "number"
        },
        "monte_carlo_standard_error_multiplier": {
          "maximum": 6.0,
          "minimum": 6.0,
          "title": "Monte Carlo Standard Error Multiplier",
          "type": "number"
        },
        "population_mse_abs_tolerance_m2": {
          "maximum": 1e-12,
          "minimum": 1e-12,
          "title": "Population Mse Abs Tolerance M2",
          "type": "number"
        }
      },
      "required": [
        "population_mse_abs_tolerance_m2",
        "grid_crossover_abs_tolerance",
        "monte_carlo_standard_error_multiplier",
        "continuous_root_reporting"
      ],
      "title": "AnalyticValidationSpec",
      "type": "object"
    },
    "AvailabilityControlEvaluation": {
      "additionalProperties": false,
      "description": "Dropout evaluation that never hides missing outputs.",
      "properties": {
        "bootstrap": {
          "$ref": "#/$defs/BootstrapSpec"
        },
        "conditional_loss_aggregation": {
          "const": "valid-object-frame-ratio-with-sequence-bootstrap",
          "title": "Conditional Loss Aggregation",
          "type": "string"
        },
        "crossover": {
          "const": "not-applicable",
          "title": "Crossover",
          "type": "string"
        },
        "fixed_fusion_missing_input_action": {
          "const": "undefined",
          "title": "Fixed Fusion Missing Input Action",
          "type": "string"
        },
        "metrics": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "coverage",
              "type": "string"
            },
            {
              "const": "conditional-matched-center-mse",
              "type": "string"
            },
            {
              "const": "undefined-output-rate",
              "type": "string"
            }
          ],
          "title": "Metrics",
          "type": "array"
        },
        "missing_output_policy": {
          "const": "undefined-no-localization-penalty",
          "title": "Missing Output Policy",
          "type": "string"
        },
        "mode": {
          "const": "availability-control",
          "title": "Mode",
          "type": "string"
        },
        "rate_aggregation": {
          "const": "count-ratio-with-sequence-bootstrap",
          "title": "Rate Aggregation",
          "type": "string"
        },
        "target_drop_identity_action": {
          "const": "fixed-fusion",
          "title": "Target Drop Identity Action",
          "type": "string"
        },
        "target_drop_nonidentity_action": {
          "const": "use-nontarget-modality",
          "title": "Target Drop Nonidentity Action",
          "type": "string"
        },
        "undefined_bootstrap_replicate_action": {
          "const": "exclude-and-require-two-sided-support",
          "title": "Undefined Bootstrap Replicate Action",
          "type": "string"
        },
        "unimodal_missing_input_action": {
          "const": "undefined",
          "title": "Unimodal Missing Input Action",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "metrics",
        "missing_output_policy",
        "rate_aggregation",
        "conditional_loss_aggregation",
        "undefined_bootstrap_replicate_action",
        "unimodal_missing_input_action",
        "fixed_fusion_missing_input_action",
        "target_drop_identity_action",
        "target_drop_nonidentity_action",
        "bootstrap",
        "crossover"
      ],
      "title": "AvailabilityControlEvaluation",
      "type": "object"
    },
    "AvailabilityControlManifest": {
      "additionalProperties": false,
