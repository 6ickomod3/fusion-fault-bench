    "AvailabilityMethods": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "camera-only",
          "type": "string"
        },
        {
          "const": "lidar-only",
          "type": "string"
        },
        {
          "const": "fixed-fusion",
