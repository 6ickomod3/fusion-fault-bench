        "observations": {
          "$ref": "#/$defs/ObservationModelsSpec"
        },
        "rng": {
          "$ref": "#/$defs/RngSpec"
        },
        "roi": {
          "$ref": "#/$defs/CommonRoiSpec"
        },
        "schema": {
          "const": "ffb.manifest/v1alpha1",
          "title": "Schema",
