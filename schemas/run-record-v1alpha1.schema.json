{
  "$defs": {
    "RuntimeEnvironment": {
      "additionalProperties": false,
      "description": "Named machine facts required for reproducibility and throughput claims.",
      "properties": {
        "cpu_model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cpu Model",
          "type": "string"
        },
        "logical_cpu_count": {
          "minimum": 1,
          "title": "Logical Cpu Count",
          "type": "integer"
        },
        "machine": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Machine",
          "type": "string"
        },
        "memory_bytes": {
          "minimum": 1,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "os_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Os Name",
          "type": "string"
        },
        "os_release": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Os Release",
          "type": "string"
        },
        "python_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "os_name",
        "os_release",
        "machine",
        "cpu_model",
        "logical_cpu_count",
        "memory_bytes"
      ],
      "title": "RuntimeEnvironment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Runtime provenance kept separate from immutable experiment intent.",
  "properties": {
    "artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Artifact Sha256"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Command",
      "type": "array"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ended At"
    },
    "environment": {
      "$ref": "#/$defs/RuntimeEnvironment"
    },
    "git_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Revision",
      "type": "string"
    },
    "lockfile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Lockfile Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "package_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Package Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema": {
      "const": "ffb.run/v1alpha1",
      "title": "Schema",
      "type": "string"
    },
    "source_dirty": {
      "title": "Source Dirty",
      "type": "boolean"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "run_id",
    "manifest_sha256",
    "package_version",
    "git_revision",
    "source_dirty",
    "lockfile_sha256",
    "command",
    "environment",
    "started_at",
    "ended_at",
    "status",
    "artifact_sha256"
  ],
  "title": "RunRecordV1Alpha1",
  "type": "object"
}
