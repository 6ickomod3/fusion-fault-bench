{
  "$defs": {
    "FaultAxis": {
      "enum": [
        "x",
        "y",
        "xy",
        "yaw",
        "time",
        "availability"
      ],
      "type": "string"
    },
    "FaultFamily": {
      "enum": [
        "additive-position-bias",
        "increased-noise-correctly-reported",
        "increased-noise-underreported",
        "calibration-translation",
        "calibration-yaw",
        "timestamp-offset",
        "dropout",
        "common-mode-position-bias"
      ],
      "type": "string"
    },
    "MethodId": {
      "enum": [
        "camera-only",
        "lidar-only",
        "fixed-fusion",
        "fault-target-drop-policy",
        "performance-oracle"
      ],
      "type": "string"
    },
    "SeverityCoordinate": {
      "additionalProperties": false,
      "description": "Machine-readable condition coordinate from a manifest fault grid.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/SeverityDirection"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "magnitude": {
          "title": "Magnitude",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/SeverityUnit"
        }
      },
      "required": [
        "index",
        "magnitude",
        "direction",
        "unit"
      ],
      "title": "SeverityCoordinate",
      "type": "object"
    },
    "SeverityDirection": {
      "enum": [
        "identity",
        "negative",
        "positive",
        "increase"
      ],
      "type": "string"
    },
    "SeverityUnit": {
      "enum": [
        "m",
        "rad",
        "s",
        "probability",
        "std-scale"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Pointwise sequence-clustered aggregate with a percentile interval.",
  "properties": {
    "aggregation": {
      "enum": [
        "object-frame-mean-then-sequence-mean",
        "valid-object-frame-ratio-with-sequence-bootstrap",
        "count-ratio-with-sequence-bootstrap"
      ],
      "title": "Aggregation",
      "type": "string"
    },
    "bootstrap_replicates": {
      "minimum": 200,
      "multipleOf": 40,
      "title": "Bootstrap Replicates",
      "type": "integer"
    },
    "confidence_level": {
      "maximum": 0.95,
      "minimum": 0.95,
      "title": "Confidence Level",
      "type": "number"
    },
    "contributing_sequence_count": {
      "minimum": 0,
      "title": "Contributing Sequence Count",
      "type": "integer"
    },
    "defined_bootstrap_replicates": {
      "minimum": 0,
      "title": "Defined Bootstrap Replicates",
      "type": "integer"
    },
    "estimate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Estimate"
    },
    "fault_axis": {
      "$ref": "#/$defs/FaultAxis"
    },
    "fault_family": {
      "$ref": "#/$defs/FaultFamily"
    },
    "interval_lower": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Interval Lower"
    },
    "interval_method": {
      "const": "paired-sequence-percentile-pointwise",
      "title": "Interval Method",
      "type": "string"
    },
    "interval_upper": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Interval Upper"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "method_id": {
      "$ref": "#/$defs/MethodId"
    },
    "metric_name": {
      "enum": [
        "matched-center-mse",
        "conditional-matched-center-mse",
        "coverage",
        "undefined-output-rate",
        "fused-minus-healthy"
      ],
      "title": "Metric Name",
      "type": "string"
    },
    "record_level": {
      "const": "aggregate",
      "title": "Record Level",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema": {
      "const": "ffb.aggregate-metric/v1alpha1",
      "title": "Schema",
      "type": "string"
    },
    "sequence_count": {
      "minimum": 2,
      "title": "Sequence Count",
      "type": "integer"
    },
    "severity": {
      "$ref": "#/$defs/SeverityCoordinate"
    },
    "status": {
      "enum": [
        "ok",
        "undefined"
      ],
      "title": "Status",
      "type": "string"
    },
    "unit": {
      "enum": [
        "m^2",
        "fraction"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "record_level",
    "run_id",
    "manifest_sha256",
    "fault_family",
    "fault_axis",
    "severity",
    "method_id",
    "metric_name",
    "status",
    "estimate",
    "interval_lower",
    "interval_upper",
    "unit",
    "sequence_count",
    "contributing_sequence_count",
    "bootstrap_replicates",
    "defined_bootstrap_replicates",
    "confidence_level",
    "interval_method",
    "aggregation"
  ],
  "title": "AggregateMetricRecordV1Alpha1",
  "type": "object"
}
