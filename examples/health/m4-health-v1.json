  "predictor": {
    "history_scope": "independent-per-modality-per-object",
    "history_length": 2,
    "history_members": ["estimate_xy_m", "reported_covariance_xy_m2", "reference_time_s"],
    "requires_strict_times": "t_a<t_b<t_k",
    "prediction_clock": "frame-reference-time-only",
    "reported_timestamp_use": "direct-residual-only",
    "h_equation": "h=(t_k-t_b)/(t_b-t_a)",
    "mean_equation": "z_pred=(1+h)*z_b-h*z_a",
    "covariance_equation": "P_pred=(1+h)^2*R_b+h^2*R_a",
    "process_noise": 0.0,
    "score_before_current_update": true,
    "unavailable_measurements_update_history": false,
    "policy_action_changes_monitoring_history": false
  },
  "features": {
    "minimum_mature_object_count": 2,
    "numeric_score_statuses": ["defined", "insufficient-support"],
    "insufficient_support_condition": "fewer-than-two-mature-current-objects-for-any-required-numeric-channel",
    "numeric_object_aggregation": ["arithmetic-mean", "maximum"],
    "self_nis_equation": "nis_m=(z_m-z_pred_m)^T*(P_pred_m+R_m)^-1*(z_m-z_pred_m)",
    "camera_from_lidar_cross_equation": "nis_camera_from_lidar=(z_camera-z_pred_lidar)^T*(P_pred_lidar+R_camera)^-1*(z_camera-z_pred_lidar)",
    "lidar_from_camera_cross_equation": "nis_lidar_from_camera=(z_lidar-z_pred_camera)^T*(P_pred_camera+R_lidar)^-1*(z_lidar-z_pred_camera)",
    "clean_ecdf_arrays": [
      "camera-self-mean",
      "camera-self-maximum",
      "lidar-self-mean",
      "lidar-self-maximum",
      "camera-from-lidar-cross-mean",
      "camera-from-lidar-cross-maximum",
      "lidar-from-camera-cross-mean",
      "lidar-from-camera-cross-maximum"
    ],
    "direct_features": [
      "current-camera-availability",
      "current-lidar-availability",
      "abs-camera-reported-minus-reference-time",
      "abs-lidar-reported-minus-reference-time"
    ],
    "diagnostic_only_features": [
      "trailing-four-frame-missing-fraction",
      "self-mature-fraction",
      "cross-mature-fraction"
    ],
    "prohibited_inputs": [
      "truth",
      "latent-velocity",
      "fault-family",
      "fault-target",
      "severity",
      "direction",
      "event-phase",
      "event-boundary",
      "seed",
      "split",
      "sequence-id",
      "manifest",
      "absolute-frame-index-as-feature"
    ]
  },
  "calibration": {
    "fit_split": "train",
    "fit_conditions": ["clean-only"],
    "fit_frames": [2, 48],
    "expected_values_per_ecdf_array": 9200,
    "ecdf_rank_equation": "rank(x)=count(clean_value<x)/clean_value_count",
    "tie_rule": "strict-less-than",
    "channel_score": "maximum-of-mean-statistic-rank-and-maximum-statistic-rank",
    "alarm_comparison": "score>threshold",
    "threshold_one_disables_numeric-alarm": true
  },
  "policy": {
    "raw_labels": ["healthy", "camera-fault", "lidar-fault", "ambiguous"],
    "raw_evidence_statuses": ["update-eligible", "insufficient-support"],
    "latched_states": ["healthy", "camera-fault", "lidar-fault", "ambiguous"],
    "executed_actions": ["camera-only", "lidar-only", "fixed-fusion", "undefined"],
    "direct_timestamp_tolerance_s": 1e-12,
    "raw_decision_rules": {
      "direct-telemetry-gate": "exactly-one-current-missing-or-timestamp-suspicious-labels-that-sensor;both-suspicious-is-ambiguous;else-healthy",
      "self-nis-gate": "exactly-one-self-alarm-labels-that-sensor;both-alarm-is-ambiguous;else-healthy",
      "cross-nis-gate": "any-directional-cross-alarm-is-ambiguous;never-attribute-target;else-healthy",
      "combined-health-gate": "direct-evidence-first;then-exactly-one-self-alarm-labels-that-sensor-or-both-ambiguous;then-any-cross-alarm-ambiguous;else-healthy"
    },
    "insufficient_support_rule": "direct-evidence-remains-update-eligible;without-direct-evidence-any-required-undefined-numeric-channel-emits-raw-ambiguous-with-insufficient-support-status",
    "insufficient_support_counter_behavior": "hold-latched-state-activation-candidate-activation-count-and-recovery-count;do-not-advance-or-reset",
    "activation_streak": 2,
    "activation_rule": "second-consecutive-identical-nonhealthy-raw-label-latches-on-current-frame",
    "activation_recurrence": "eligible-healthy-sets-count-0;eligible-nonhealthy-matching-candidate-increments;eligible-nonhealthy-contrary-label-becomes-new-candidate-with-count-1",
    "recovery_streak": 3,
    "recovery_rule": "third-consecutive-raw-healthy-restores-healthy-on-current-frame",
    "counter_reset_rule": "contrary-raw-evidence-resets-relevant-counter",
    "latched_attribution_switching": "never-switch-until-recovered-healthy",
    "action_rules": {
      "neither-modality-available": "undefined",
      "only-camera-available": "camera-only-immediately-regardless-of-latch",
      "only-lidar-available": "lidar-only-immediately-regardless-of-latch",
      "both-available-and-healthy": "fixed-fusion",
      "both-available-and-camera-fault": "lidar-only",
      "both-available-and-lidar-fault": "camera-only",
      "both-available-and-ambiguous-nonabstaining": "fixed-fusion",
      "both-available-and-ambiguous-abstaining": "undefined"
    },
    "detection_uses": "latched-state-not-raw-label",
    "missing-input-action-override_is_not_detection": true
  },
  "fault_target_drop_policy": {
    "outside_active_event": "fixed-fusion",
    "inside_active_single-target_event": "non-target-modality-only",
    "selected-modality-unavailable": "undefined",
    "availability_fallback_to_target": false,
    "identity_condition": "fixed-fusion",
    "common_mode_applicable": false,
    "deployable": false
  },
  "methods": [
    "camera-only",
    "lidar-only",
    "fixed-fusion",
    "self-nis-gate",
    "cross-nis-gate",
    "direct-telemetry-gate",
    "combined-health-gate",
    "combined-health-gate-abstain",
    "fault-target-drop-policy",
    "frame-action-performance-oracle"
  ],
  "threshold_selection": {
    "self_thresholds": [0.95, 0.975, 0.99, 0.995, 0.999, 1.0],
    "cross_thresholds": [0.95, 0.975, 0.99, 0.995, 0.999, 1.0],
    "candidate_count": 36,
    "iteration_order": "self-threshold-ascending-outer-then-cross-threshold-ascending-inner",
    "selected_policy": "combined-health-gate",
    "all_deployable_ablations_share_selected_thresholds": true,
    "feasibility": {
      "condition_id": "validation-main-clean",
      "mean_clean_regression_m2_max": 0.002,
      "upper_pointwise_95pct_clean_regression_m2_max": 0.005,
      "false_alert_episode_starts_per_clean_sequence_max": 0.05,
      "clean_coverage_must_equal_fixed": true
    },
    "selection_conditions": [
      "validation-camera-output-y-bias",
      "validation-lidar-output-y-bias",
      "validation-camera-noise-underreported",
      "validation-lidar-noise-underreported",
      "validation-camera-noise-correctly-reported",
      "validation-lidar-noise-correctly-reported",
      "validation-camera-calibration-x"
    ],
    "objective": "mean-score-window-policy-minus-frame-action-oracle-regret-with-equal-target-then-equal-family-then-equal-condition-weighting",
    "tie_tolerance_m2": 1e-12,
    "tie_break_order": [
      "lower-false-alert-episode-starts",
      "lower-clean-regression",
      "larger-self-threshold",
      "larger-cross-threshold"
    ],
    "no_feasible_candidate": "hard-preregistration-failure-no-gate-relaxation",
    "retain_all_candidate_records": true,
    "fit_artifact_must_exist_before_test": true,
    "test_threshold_override": false,
    "test_refit": false
  },
  "oracle": {
    "id": "frame-action-performance-oracle",
    "action_granularity": "one-action-per-frame-shared-by-all-eligible-objects",
    "candidate_actions": ["camera-only", "lidar-only", "fixed-fusion"],
    "selection_rule": "minimum-current-frame-mean-squared-center-loss-among-currently-defined-actions",
    "tie_break_order": ["camera-only", "lidar-only", "fixed-fusion"],
    "sequence_aggregation": "sum-selected-action-object-loss-over-defined-eligible-object-frames-divided-by-selected-valid-count",
    "hindsight": true,
    "deployable": false,
    "dominance_gate": "loss-no-greater-than-every-nonabstaining-policy-on-identical-frame-support",
    "common_mode_applicable": false,
    "unequal_coverage_recovery_fraction": false
  },
  "evaluation": {
    "loss_windows_by_schedule": {
      "standard": {
        "score": [2, 48],
        "event": [12, 36],
        "recovery": [36, 48]
      },
      "cold_start": {
        "score": [0, 48],
        "event": [0, 24],
        "recovery": [24, 48]
      }
    },
    "primary_contrast": "fixed-fusion-loss-minus-policy-loss-positive-means-policy-gain",
    "clean_regression": "policy-loss-minus-fixed-fusion-loss",
    "target_drop_gap": "policy-loss-minus-fault-target-drop-loss",
    "frame_oracle_gap": "policy-loss-minus-frame-action-performance-oracle-loss",
    "frame_oracle_recovery_fraction": "(fixed-loss-policy-loss)/(fixed-loss-frame-oracle-loss)",
    "recovery_fraction_denominator_tolerance_m2": 1e-12,
