  "event_schedules": {
    "standard": {
      "frame_count": 48,
      "predictor_initialization_frames": [0, 2],
      "clean_prefix_frames": [0, 12],
      "score_frames": [2, 48],
      "fault_active_frames": [12, 36],
      "recovery_frames": [36, 48]
