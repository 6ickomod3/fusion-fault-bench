  "observation_model": {
    "camera_actual_std_xy_m": [1.0, 1.0],
    "camera_reported_std_xy_m": [1.0, 1.0],
    "lidar_actual_std_xy_m": [0.3, 0.3],
    "lidar_reported_std_xy_m": [0.3, 0.3],
    "base_error_dependence": "temporally-iid-independent-between-modalities",
    "paired_base_draws_across_conditions_methods_and_policies": true,
    "actual_error_separate_from_reported_covariance": true,
    "fault_generation_uses_true_state_pose_and_time": true,
    "metadata_faults_apply_only_to_reconstruction_or_alignment": true
