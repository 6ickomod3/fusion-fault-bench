{
  "schema": "ffb.manifest/v1alpha1",
  "kind": "geometry-crossover",
  "experiment": "procedural-camera-calibration-x",
  "rng": {
    "engine": "numpy-pcg64dxsm-v1",
    "stream_derivation": "sha256-name-and-sequence-v1",
    "data_master_seed": 1729,
    "bootstrap_seed": 2718,
    "data_streams": ["latent", "camera", "lidar", "fault"]
  },
  "source": {
    "kind": "procedural",
    "split": "test",
    "profile_id": "constant-velocity-front-roi-v1",
    "profile_sha256": "4771a6e69d75b9af41f99ab794c0af1b51e6103e43474c8e0f07df3e6f3ca68c",
    "sequence_count": 200
  },
  "roi": {
    "frame": "ego-bev",
    "x_min_m": 5.0,
    "x_max_m": 60.0,
    "abs_y_max_m": 40.0,
    "camera_half_fov_rad": 0.7
  },
  "observations": {
    "camera": {
      "output_space": "ego-bev-xy",
      "true_error_distribution": "gaussian",
      "true_error_mean_xy_m": [0.0, 0.0],
      "true_covariance_structure": "diagonal",
      "actual_std_xy_m": [1.0, 1.0],
      "reported_covariance_structure": "diagonal",
      "reported_std_xy_m": [1.0, 1.0],
      "temporal_dependence": "iid",
      "range_dependence": "constant"
    },
    "lidar": {
      "output_space": "ego-bev-xy",
      "true_error_distribution": "gaussian",
      "true_error_mean_xy_m": [0.0, 0.0],
      "true_covariance_structure": "diagonal",
      "actual_std_xy_m": [0.3, 0.3],
      "reported_covariance_structure": "diagonal",
      "reported_std_xy_m": [0.3, 0.3],
      "temporal_dependence": "iid",
      "range_dependence": "constant"
    },
    "base_stochastic_sensor_errors": "independent"
  },
  "fault_sweep": {
    "kind": "calibration-translation",
    "target": "camera",
    "axis": "x",
    "unit": "m",
    "injection_site": "calibration-metadata",
    "perturbation_frame": "ego",
    "direction_policy": "symmetric-paired",
    "persistence": "sequence",
    "magnitude_values_m": [0.0, 0.25, 0.5, 1.0, 2.0, 4.0]
