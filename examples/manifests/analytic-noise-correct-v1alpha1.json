{
  "schema": "ffb.manifest/v1alpha1",
  "kind": "analytic-crossover",
  "experiment": "analytic-camera-noise-correctly-reported",
  "rng": {
    "engine": "numpy-pcg64dxsm-v1",
    "stream_derivation": "sha256-name-and-sequence-v1",
    "data_master_seed": 1729,
    "bootstrap_seed": 2718,
    "data_streams": ["latent", "camera", "lidar", "fault"]
  },
  "source": {
    "kind": "analytic",
    "case_id": "one-object-static-local-error-gaussian-v1",
    "sequence_count": 200
  },
  "analytic_validation": {
    "population_mse_abs_tolerance_m2": 1e-12,
    "grid_crossover_abs_tolerance": 1e-12,
    "monte_carlo_standard_error_multiplier": 6.0,
    "continuous_root_reporting": "separate-from-grid-estimand"
  },
  "observations": {
    "camera": {
      "output_space": "ego-bev-xy",
      "true_error_distribution": "gaussian",
      "true_error_mean_xy_m": [0.0, 0.0],
      "true_covariance_structure": "diagonal",
      "actual_std_xy_m": [1.5, 0.6],
      "reported_covariance_structure": "diagonal",
      "reported_std_xy_m": [1.5, 0.6],
      "temporal_dependence": "iid",
      "range_dependence": "constant"
    },
    "lidar": {
      "output_space": "ego-bev-xy",
      "true_error_distribution": "gaussian",
      "true_error_mean_xy_m": [0.0, 0.0],
      "true_covariance_structure": "diagonal",
      "actual_std_xy_m": [0.25, 0.25],
      "reported_covariance_structure": "diagonal",
      "reported_std_xy_m": [0.25, 0.25],
      "temporal_dependence": "iid",
      "range_dependence": "constant"
    },
    "base_stochastic_sensor_errors": "independent"
  },
  "fault_sweep": {
    "kind": "increased-noise-correctly-reported",
    "target": "camera",
    "axis": "xy",
    "unit": "std-scale",
    "injection_site": "true-error-model",
    "reported_uncertainty": "tracks-actual",
    "persistence": "sequence-configuration",
    "std_scale_values": [1.0, 1.25, 1.5, 2.0, 4.0]
  },
  "methods": [
    "camera-only",
    "lidar-only",
    "fixed-fusion",
    "fault-target-drop-policy",
    "performance-oracle"
  ],
  "evaluation": {
    "mode": "primary-single-sensor-crossover",
    "primary_loss": "matched-center-mse",
    "loss_unit": "m^2",
    "aggregation": "object-frame-mean-then-sequence-mean",
    "primary_contrast": "fused-minus-healthy",
    "bootstrap": {
      "method": "percentile",
      "unit": "sequence",
      "resampling": "paired-indices-across-severities-and-methods",
      "interval_scope": "pointwise",
      "replicates": 2000,
      "confidence_level": 0.95
    },
    "crossover": {
      "fit": "nondecreasing-isotonic-pava",
      "fit_weights": "equal-severity",
      "interpolation": "linear-first-zero",
      "zero_tolerance_m2": 1e-12,
      "no_crossing_handling": "right-censored-above-tested-maximum",
      "status_rule": "two-sided-bootstrap-crossing-fraction"
    },
    "target_drop_identity_action": "fixed-fusion",
    "performance_oracle_selection_unit": "sequence",
    "performance_oracle_candidates": [
      "camera-only",
      "lidar-only",
      "fixed-fusion"
    ],
    "oracle_recovery_denominator_tolerance_m2": 1e-12
  }
}
